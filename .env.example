# ── Environment ──────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# ── Google APIs ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── Resend (Email) ───────────────────────────
RESEND_API_KEY=

# ── Security ─────────────────────────────────
# Shared secret for trusted server-to-server callers (e.g. Next.js backend)
SUN_API_SECRET=
# Secret used to HMAC-sign approve/reject/cancel links in emails
APPROVAL_TOKEN_SECRET=
